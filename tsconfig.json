{
  "compilerOptions": {
    "moduleResolution": "Bundler", 
    "target": "ESNext",
    "module": "ESNext",
    
    "paths": {
      "@pages/*": ["./pages/*"],
      "@fixtures/*": ["./fixtures/*"],
      "@managers/*": ["./managers/*"],
      "@base/*": ["./pages/base_entities/*"],
      "@utils/*": ["./utils/*"]
    },

    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    
    "types": ["node"],

    "experimentalDecorators": true,
    "emitDecoratorMetadata": true
  }
}